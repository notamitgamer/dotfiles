color-link default "#ECEFF4,"
color-link comment "italic #6272A4"
color-link identifier "#00FFA3"
color-link statement "bold #BD00FF"
color-link symbol "#00B4D8"
color-link constant "#FFD300"
color-link special "#FF3366"
color-link type "bold #00F0FF"
color-link line-number "bold #00B4D8"
color-link current-line-number "bold #00FFA3"
color-link gutter-warning "#FFD300"
color-link gutter-error "#FF3366"
color-link statusline "bold #0A0E14,#00FFA3"
